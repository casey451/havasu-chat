# AZCC towing verifier captcha unblock (wave-3, V1.5 N11)
# Cookie-primary path: paste from `python scripts/azcc_seed_cookie.py` output
AZCC_SESSION_COOKIE=
# Tesseract OCR fallback path (feature flag, default off)
AZCC_TESSERACT_ENABLED=0
AZCC_TESSERACT_MAX_RETRIES=3

# Google Places API (enrichment, discovery, provider photo URLs)
GOOGLE_PLACES_API_KEY=

# Embeddings provider (app/core/embeddings.py — HANDOFF #3)
#   openai (default): OpenAI embeddings, text-embedding-3-small (1536-dim).
#   local: an OpenAI-compatible endpoint (e.g. Ollama nomic-embed-text on the VPS).
# A provider switch changes the vector dimension, which invalidates previously
# stored embeddings (the cache degrades to no-similarity-match, not a wrong hit).
EMBEDDINGS_PROVIDER=openai
# Only for EMBEDDINGS_PROVIDER=local:
EMBEDDINGS_BASE_URL=
# EMBEDDINGS_API_KEY=          # optional; local servers ignore it
# EMBEDDINGS_MODEL=            # override (default: text-embedding-3-small / nomic-embed-text)
