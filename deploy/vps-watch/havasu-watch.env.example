# Ask Hava VPS watchdog -- environment for the systemd timer.
# Install to /etc/havasu/havasu-watch.env (root:root, 0600 -- it holds the
# Resend API key):
#   sudo install -m 600 -o root -g root havasu-watch.env /etc/havasu/havasu-watch.env

# Where alerts go. Unset -> the watchdog runs LOG-ONLY (safe to install first).
WATCH_ALERT_EMAIL=you@example.com

# Reuse the app's Resend sender (same values Railway uses for magic-link/alert
# email). Without these, send falls back to log-only.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Ask Hava Alerts <noreply@askhava.com>

# Optional overrides (defaults shown):
# WATCH_HEALTH_URL=https://askhava.com/health
# WATCH_SCRAPER_UNIT=havasu-vision-scrape.service
# WATCH_SCRAPER_MAX_AGE_H=50
# WATCH_DISK_PATH=/
# WATCH_DISK_PCT_MAX=90
# WATCH_HOST_LABEL=srv1729030
