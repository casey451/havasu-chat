# Ask Hava vision scrapers -- environment for the VPS timer.
# Copy to /etc/havasu/havasu-vision.env and fill in. It holds DB credentials, so:
#   sudo install -m 600 -o root -g root havasu-vision.env /etc/havasu/havasu-vision.env

# Prod Postgres (same connection string the Railway app uses).
DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DBNAME

# Self-hosted, OpenAI-compatible vision endpoint (Ollama on this box = localhost).
VISION_BASE_URL=http://127.0.0.1:11434/v1
VISION_MODEL=qwen2.5vl:3b

# Calendar tiling -- the robust fix for dense grids on a CPU box. Splits each
# calendar image into N overlapping bands so each request's image + output stays
# small (fits the default window, fast per call); rows are merged/deduped across
# tiles. 2 is plenty for these monthly grids; raise to 3 if a tile still truncates.
VISION_CALENDAR_TILES=2

# Output budget (first-class OpenAI param, honored by Ollama as num_predict).
# VISION_MAX_TOKENS=4096
# NOTE: VISION_NUM_CTX is IGNORED by Ollama's /v1 endpoint (the model stays at its
# built-in 4096), so tiling above is what makes dense calendars fit. If you'd rather
# not tile, bake a bigger window into a model variant instead -- see
# deploy/vps-vision/havasu-qwen-cal.Modelfile -- and point VISION_MODEL at it.
# VISION_NUM_CTX=8192

# Only if you put the endpoint behind an auth proxy (Ollama itself has no auth):
# VISION_API_KEY=changeme

# Per-run caps on vision calls (defaults shown).
# PARKS_REC_FLYER_MAX=8
# SENIOR_FLYER_MAX=12

# Where the repo + venv live on this VPS.
HAVASU_REPO_DIR=/opt/havasu-chat
HAVASU_PY=/opt/havasu-chat/.venv/bin/python
