[Unit]
Description=Ask Hava vision image scrapers (Parks & Rec + Senior Center)
# Wait for the network and the local model server before running.
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=oneshot
# Run as a non-root service account that owns the repo + venv.
User=havasu
Group=havasu
WorkingDirectory=/opt/havasu-chat
EnvironmentFile=/etc/havasu/havasu-vision.env
ExecStart=/opt/havasu-chat/deploy/vps-vision/run_vision_scrapes.sh
# Generous timeout: small CPU vision models are slow, and a larger VISION_NUM_CTX
# (needed so dense calendars don't truncate) makes each image slower still. A full
# ~22-image run can exceed 30 min on a CPU box -- give it 60 min of headroom.
TimeoutStartSec=3600
# Light hardening.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
