{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8000/lake-styleguide?theme=lake",
        "http://127.0.0.1:8000/home?theme=lake",
        "http://127.0.0.1:8000/events-ui?theme=lake",
        "http://127.0.0.1:8000/calendar?q=live%20music%20this%20weekend"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["warn", { "minScore": 1.0 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
