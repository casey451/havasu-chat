# Local env files (secrets); .env.example template may be tracked
.env
.env.*
!.env.example
.claude/
search_debug.log
*.db

# Local-dev data directory (SQLite DBs, scratch fixtures)
data/
__pycache__/
*.pyc
.pytest_cache/

# Local-only session notes (not durable project artifacts)
docs/phase2-assistant-log.md

# Windows shortcut dropped in docs by mistake
docs/*Shortcut*.lnk

# Script-generated local extracts (do not commit)
scripts/output/

diag.json
tmp/
scratch/

# Chat-exported Cursor prompt copies (canonical versions are tracked separately)
docs/phase-*-cursor-prompt-chat-export.md

# Cursor handback and pre-flight-stop reports (scratch, not permanent)
docs/phase-*-handback-*.md
docs/phase-*-preflight-stop-*.md

# Relay session artifacts (HALT transcripts, status reports, etc.)
# Only relay/README.md is intended to stay tracked; see that file for context.
relay/
!relay/README.md
scripts/confabulation_eval_results/*
!scripts/confabulation_eval_results/baselines/
*.log
sentinel_ids*.txt

# pg_dump output; do not commit production backups
*.sql

# Ruff (Slice 39 Phase D)
.ruff_cache/

# Per-ship verify/commit .cmd scaffolding (ephemeral; the result.txt files
# are produced by the .cmd runs and never need to be tracked). Canonical
# .cmds for a ship live at repo root or are committed intentionally; these
# patterns only cover the throwaway _<topic>_*.cmd / _<topic>_*_result.txt
# shape used per-session under outputs/.
outputs/_*.cmd
outputs/_*_result.txt
outputs/_*_result.json
outputs/_*_msg.txt

# Also match at repo root + any other location: ephemeral scratchpad .cmds
# have accumulated at the workspace root too (pre-outputs/-convention
# vintage; e.g. 2026-05-22 verify/commit pairs for the lhcaz_aquatic
# disable + flag-flip-close-out + state-md commits dropped at root rather
# than under outputs/). These bare-pattern extensions catch both root and
# any future location so the same gotcha (stale .cmd accidentally
# double-clicked → wrong commit message) is structurally suppressed.
_*.cmd
_*.bat
_*.ps1
_*_result.txt
_*_result.json
_*_msg.txt

# Session scratchpad directories. outputs/ accumulates per-session
# handoffs, draft patches, .cmd scaffolding, and other artifacts; nothing
# under it is currently tracked. mockups/ holds UI exploration HTML that
# also lives outside version control. Without these patterns, `git add -A`
# in either directory is a common foot-gun.
outputs/
mockups/

# Backup files. Any *.bak anywhere, plus the specific .git/config.bak*
# files that the Cowork Edit tool drops next to .git/config when it
# repairs that file (see Appendix C.4 in
# outputs/cowork_upstream_bug_report_fuse_stale_inode.md).
*.bak
.git/config.bak*

# Shell-misfire orphan files at the repo root. `'%I'` came from an
# unquoted batch `for /f %%I in (...)` token leaking into a redirection;
# `tatus` came from a partial `git status` typo redirected to a file.
# Both are harmless on disk but pollute `git status` output. The
# patterns here suppress them in case they ever come back.
'%I'
%I
tatus
